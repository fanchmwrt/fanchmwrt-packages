msgid "No SSID is configured on this radio. Configure it in the advanced wireless page first."
msgstr "该射频尚未配置 SSID，请先在高级无线页面中配置。"

msgid "Client, relay and other non-AP configurations are read-only here."
msgstr "客户端、中继及其他非普通 AP 配置在此页面仅供查看，不支持修改。"

msgid "This configuration requires advanced wireless settings and is read-only here."
msgstr "此配置需要高级无线参数或当前未提供的加密能力，在此页面仅供查看。"

msgid "SSID must contain 1 to 32 bytes without control characters."
msgstr "无线名称须为 1～32 字节，不能包含控制字符（中文通常占 3 字节）。"

msgid "Use 8 to 63 bytes, or a 64-digit hexadecimal WPA key. WPA3-SAE accepts 1 to 63 bytes."
msgstr "密码须为 8～63 字节；WPA 支持 64 位十六进制密钥，纯 WPA3-SAE 支持 1～63 字节。"

msgid "No changes to save"
msgstr "没有需要保存的修改"

msgid "Applying wireless settings will disconnect wireless clients. Continue?"
msgstr "应用无线配置将断开无线客户端连接，是否继续？"

msgid "Settings saved. Wireless is restarting; reconnect using the new SSID and password if necessary."
msgstr "配置已保存，正在重启无线。若连接断开，请使用新的无线名称和密码重新连接。"

msgid "The connection was interrupted. Settings may have been applied. Reconnect and refresh to confirm."
msgstr "连接已中断，配置可能已生效。请重新连接后刷新页面确认。"

msgid "Save failed. Refresh the page and check the wireless configuration."
msgstr "保存失败，请刷新页面并检查无线配置是否已变化或不受支持。"

msgid "Discard unsaved changes and reload?"
msgstr "放弃未保存的修改并重新加载？"

msgid "Not supported by this firmware or band"
msgstr "当前固件或频段不支持"

msgid "Wireless is restarting, please wait."
msgstr "无线正在重启，请稍后"

msgid "Countdown"
msgstr "倒计时"

msgid "seconds"
msgstr "秒"
